SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required — Supabase Postgres (Session pooler recommended on IPv4 networks)
# Encode special password chars: @ -> %40
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional: pin pooler IPv4 if local DNS fails (nslookup HOST 8.8.8.8)
DATABASE_HOSTADDR=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# GrantedAI (optional — anonymous demo key is used if blank)
# Get your own key at https://grantedai.com/developers
GRANTED_API_KEY=

CELERY_BROKER_URL=redis://localhost:6379/0
