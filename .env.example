SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Required — Supabase Postgres (Session pooler recommended on IPv4 networks)
# Encode special password chars: @ -> %40
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Optional: pin pooler IPv4 if local DNS fails (nslookup HOST 8.8.8.8)
DATABASE_HOSTADDR=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Agents SDK matching is ON by default when OPENAI_API_KEY is set.
# Set to 0 to force asyncio.gather fallback (no LLM tool orchestration).
GRANT_USE_AGENT=1
# Dedicated AI ranking after tool results (Agents SDK scoring agent).
GRANT_USE_AI_SCORE=1
# Drop past deadlines; if no deadline, drop open_date older than N months (0 = disable open_date age check).
GRANT_MAX_OPEN_AGE_MONTHS=6
# Optional; omit if your model rejects custom temperature.
# OPENAI_SCORE_TEMPERATURE=0.2

# GrantedAI (optional — anonymous demo key is used if blank)
# Get your own key at https://grantedai.com/developers
GRANTED_API_KEY=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TIMEZONE=UTC
# Monday digest clock (Celery Beat). Keep worker + beat running.
WEEKLY_DIGEST_HOUR_UTC=9
WEEKLY_DIGEST_MINUTE_UTC=0

# Weekly grant digest → n8n (n8n sends the actual email)
N8N_WEEKLY_GRANTED_WEBHOOK_URL=
# Header name/value must match the n8n webhook node's Header Auth credential.
N8N_WEBHOOK_AUTH_HEADER=X-Webhook-Token
N8N_WEBHOOK_AUTH_HEADER_VALUE=
N8N_WEBHOOK_TIMEOUT_SECONDS=60
# Absolute base URL used for links inside the email
SITE_BASE_URL=http://localhost:8000
SITE_NAME=Grants
# 0 = send every ranked grant in the email (recommended).
WEEKLY_DIGEST_MAX_GRANTS=0
# Matcher pool size when MAX_GRANTS is 0 (chat UI still shows 12).
WEEKLY_DIGEST_MATCHER_LIMIT=50
# Optional Reply-To passed through to n8n
WEEKLY_DIGEST_REPLY_TO=
